<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Scoped to Goop.PackageTests only.

       <clear /> first, so no machine-wide feed can take part. Then two sources,
       and a MAPPING that says which package may come from where:

         * Goop  -> ONLY the local folder feed (artifacts/packages), which is
                    where `dotnet pack` puts it. Without this mapping, a restore
                    could be satisfied by some unrelated package that happens to
                    be called "Goop" on nuget.org.
         * everything else (MSTest etc.) -> nuget.org.

       Relative paths resolve against THIS file's folder
       (dotnet/tests/Goop.PackageTests/), so the repo root is three levels up. -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="goop-local" value="..\..\..\artifacts\packages" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="goop-local">
      <package pattern="Goop" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
