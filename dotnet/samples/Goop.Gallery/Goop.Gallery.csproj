<Project Sdk="Microsoft.NET.Sdk">

  <!-- The showcase console app: builds interesting shapes and writes them to
       gallery/output/ as STL. It doubles as the quickest manual smoke test of
       the whole stack, which is why it runs on both frameworks. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Goop.Gallery</RootNamespace>
    <AssemblyName>Goop.Gallery</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Goop\Goop.csproj" />
  </ItemGroup>

  <!-- Same native DLL copy as Goop.Tests, for the same reason: the OS loader
       resolves "goop.dll" starting from the directory of the running
       executable, and CMake's output is outside the MSBuild graph entirely.
       Deliberately duplicated rather than factored into a shared .targets file,
       so that each project states its own dependency on the native build where
       someone opening that project will see it.

       A warning rather than an error keeps `dotnet build` working on a clean
       clone before CMake has ever run. -->
  <!-- The TargetFramework condition matters: a multi-targeting project runs
       "Build" twice over, once in the OUTER pass that merely dispatches to each
       framework and once per framework in the INNER builds. Only the inner
       builds have an output directory, so without this guard the outer pass
       fires the Copy with an empty destination and fails the build. -->
  <Target Name="CopyGoopNativeLibrary" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">

    <Warning Condition="!Exists('$(GoopNativeBinDir)goop.dll')"
             Code="GOOP0001"
             Text="Native goop.dll was not found at '$(GoopNativeBinDir)'. The sample will build but will throw DllNotFoundException as soon as it touches a shape. Build the native side first: scripts\build.ps1 -Configuration $(Configuration)" />

    <ItemGroup>
      <GoopNativeArtifact Include="$(GoopNativeBinDir)goop.dll" Condition="Exists('$(GoopNativeBinDir)goop.dll')" />
      <GoopNativeArtifact Include="$(GoopNativeBinDir)goop.pdb" Condition="Exists('$(GoopNativeBinDir)goop.pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(GoopNativeArtifact)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(GoopNativeArtifact)' != ''" />

  </Target>

</Project>
