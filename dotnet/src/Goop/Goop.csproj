<Project Sdk="Microsoft.NET.Sdk">

  <!-- The managed half of Goop: a fluent, IDisposable wrapper over the C ABI in
       native/include/goop/goop.h. This assembly contains no native code and
       does not build goop_native.dll - it only knows how to call it. -->

  <PropertyGroup>
    <!-- Three target frameworks on purpose, and a change has to pass all three.
         net8.0 and net10.0 are where modern interop lives (NativeLibrary, real
         Span support); net48 is the one that catches the mistakes, because
         .NET Framework is stricter about marshalling, defaults to 32-bit, and
         has none of the newer convenience APIs. If the library works on all
         three, the interop is probably actually correct. -->
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>

    <RootNamespace>Goop</RootNamespace>
    <AssemblyName>Goop</AssemblyName>

    <!-- Needed for fixed / stackalloc / raw pointer work when copying vertex and
         index buffers out of the native mesh without an intermediate array. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata. Goop.PackageTests consumes the result. -->
  <PropertyGroup>
    <PackageId>Goop</PackageId>
    <Version>0.1.0</Version>
    <Authors>raiden-02</Authors>
    <Description>A tiny signed-distance-field sculpting kernel: shapes that melt into each other, meshed to triangles and exported as STL.</Description>
    <PackageTags>sdf;signed-distance-field;csg;mesh;stl;interop</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/raiden-02/goop</RepositoryUrl>
    <PackageProjectUrl>https://github.com/raiden-02/goop</PackageProjectUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Goop.Tests reach the Goop.Internal types (NativeMethods, the
         SafeHandles) so interop can be tested directly instead of only through
         the public fluent surface. -->
    <InternalsVisibleTo Include="Goop.Tests" />
  </ItemGroup>

  <!-- net48 ONLY: polyfills for types the modern frameworks have built in.

       Span<T> / ReadOnlySpan<T> / Memory<T> do not exist in .NET Framework 4.8,
       and LangVersion=latest does NOT conjure them up - that setting unlocks
       compiler syntax, never runtime APIs. Without these two packages, a
       batch-evaluation signature like

           Evaluate(ReadOnlySpan<Vec3> points, Span<double> distances)

       compiles on net8.0/net10.0 and fails on net48, which is exactly the
       three-framework trap this project exists to stay out of.

       Note these are REFERENCE assemblies bridging to the same underlying
       memory, so pinning a Span and handing its pointer to native code behaves
       the same on all three. On net8.0+ the SDK supplies these inbox and adding
       the packages would downgrade them, hence the condition. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
  </ItemGroup>

  <!-- =====================================================================
       Packing the NATIVE DLL.

       A managed-only package is just lib/<tfm>/Goop.dll. Ours must also carry
       goop_native.dll, and the two consumer worlds find native DLLs
       differently:

         * .NET 8 / .NET 10 (CoreCLR) read the package's runtimes/<rid>/native/
           folder. The SDK copies it into the consumer's output and records it
           in <app>.deps.json, and the host resolves the P/Invoke from there.

         * .NET Framework 4.8 knows nothing about runtimes/ or deps.json. The
           OS loader simply looks next to the executable. So the package ships a
           small build/net48/Goop.targets that NuGet imports into net48
           consumers, which copies the DLL beside their output.

       Resulting package layout:
         lib/net48/Goop.dll   lib/net8.0/Goop.dll   lib/net10.0/Goop.dll
         runtimes/win-x64/native/goop_native.dll
         build/net48/Goop.targets   buildTransitive/net48/Goop.targets

       (buildTransitive: so a consumer's consumer also gets the copy.)

       Future: if other platforms ever appear, the native payload moves into a
       separate Goop.runtime.win-x64 package that Goop depends on - the pattern
       the larger libraries use.
       ===================================================================== -->
  <PropertyGroup>
    <!-- Repo-root artifacts/packages: the local folder feed that
         Goop.PackageTests restores from. Git-ignored. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\..\artifacts\packages\</PackageOutputPath>
    <!-- NU5100 warns about a DLL outside lib/. Ours is NATIVE and belongs in
         runtimes/, so the warning does not apply. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(GoopNativeBinDir)goop_native.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Visible="false" />
    <None Include="build\Goop.targets" Pack="true" PackagePath="build/net48/;buildTransitive/net48/" />
  </ItemGroup>

  <!-- A package without its native DLL restores fine and then throws
       DllNotFoundException on the first call - in someone else's app. Fail the
       pack HERE instead, loudly. -->
  <Target Name="GoopRequireNativeForPack" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(GoopNativeBinDir)goop_native.dll')"
           Code="GOOP0002"
           Text="Cannot pack Goop: the native library is missing at '$(GoopNativeBinDir)goop_native.dll'. Build the native side first (scripts\build.ps1 -Configuration $(Configuration))." />
  </Target>

</Project>
