<Project Sdk="Microsoft.NET.Sdk">

  <!-- The managed half of Goop: a fluent, IDisposable wrapper over the C ABI in
       native/include/goop/goop.h. This assembly contains no native code and
       does not build goop.dll - it only knows how to call it. -->

  <PropertyGroup>
    <!-- Two target frameworks on purpose. net8.0 is where modern interop lives
         (NativeLibrary, better Span support); net48 is the one that catches the
         interop mistakes, because .NET Framework is stricter about marshalling,
         defaults to 32-bit, and has none of the newer convenience APIs. If the
         library works on both, the interop is probably actually correct. -->
    <TargetFrameworks>net48;net8.0</TargetFrameworks>

    <RootNamespace>Goop</RootNamespace>
    <AssemblyName>Goop</AssemblyName>

    <!-- Needed for fixed / stackalloc / raw pointer work when copying vertex and
         index buffers out of the native mesh without an intermediate array. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata. Placeholders for now; the actual packaging milestone is
       M8, and Goop.PackageTests exists to consume the result. -->
  <PropertyGroup>
    <PackageId>Goop</PackageId>
    <Version>0.1.0</Version>
    <Authors>raiden-02</Authors>
    <Description>A tiny signed-distance-field sculpting kernel: shapes that melt into each other, meshed to triangles and exported as STL.</Description>
    <PackageTags>sdf;signed-distance-field;csg;mesh;stl;interop</PackageTags>
    <!-- Nothing is published anywhere yet. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Goop.Tests reach the Goop.Internal types (NativeMethods, the
         SafeHandles) so interop can be tested directly instead of only through
         the public fluent surface. -->
    <InternalsVisibleTo Include="Goop.Tests" />
  </ItemGroup>

  <!-- =====================================================================
       TODO (MILESTONE M8): pack goop.dll into the NuGet package.

       Deliberately NOT implemented yet. Right now the native DLL reaches the
       test and sample projects through a plain copy target (see
       Goop.Tests.csproj), which is enough for local development. Shipping it in
       a package is a separate problem with its own decisions to make.

       The shape it needs to take:

         <ItemGroup>
           <None Include="$(GoopNativeBinDir)goop.dll"
                 Pack="true"
                 PackagePath="runtimes/win-x64/native/"
                 Visible="false" />
         </ItemGroup>

       Things to work out before switching that on:

         * runtimes/win-x64/native/ is the RID-specific convention. The SDK only
           resolves it for consumers that are RID-aware. A plain net48 consumer
           with no RuntimeIdentifier will NOT get the DLL copied to its output -
           that usually needs a build/Goop.targets inside the package doing the
           copy explicitly, shipped under build/ and build/net48/.

         * Packing requires the native build to have already run for the
           matching configuration. Decide whether `dotnet pack` should fail
           loudly when goop.dll is missing (it should) rather than silently
           producing a package that throws DllNotFoundException at run time.

         * One package with a win-x64 payload, or a separate Goop.runtime.win-x64
           package that Goop depends on? The second is how the bigger libraries
           do it and is the answer if other platforms ever appear.

         * PackageReadmeFile, license, and repository metadata all want filling
           in before this is published anywhere.
       ===================================================================== -->

</Project>
